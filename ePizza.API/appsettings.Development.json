{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DatabaseConnection": "Data Source=LAPTOP-CVQ0CCQV; Initial Catalog=PB605; User Id=sa; Password=admin123;TrustServerCertificate=True;"
  },
  "jwt": {
    "Secret": "82f79ae8-c7cf-46df-bf17-abf9ba8c1a8a",
    "Issuer": "ePizzaHubAPI",
    "Audience": "ePizzaHubUI",
    "TokenExpiryInMinute": "60"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Expressions" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "WithMachineName",
      "WithThreadId",
      "WithExceptionDetails",
      "WithEnvironmentName",
      "FromLogContext"
    ],
    "Properties": {
      "Application": "ePizzaAPI"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{MachineName}|{RequestId}|{SourceContext}] {Message}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-development-.txt",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{MachineName}|{RequestId}|{SourceContext}] {Message}{NewLine}{Exception}",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  }

}
