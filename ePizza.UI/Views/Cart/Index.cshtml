@using ePizza.UI.Models.ApiResponses

@model GetCartResponseModel
@{
    ViewData["Title"] = "CArt Details";
}
<div>
    @if(Model != null && Model.Items !=null)
    {
        <div class="row" >
            <div class="col-sm-8">
                <div class="card">
                    <div class="card-header">
                        <h3>Cart Items=(@Model.Items.Count())</h3>
                    </div>
                    <div class="card-body">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Details</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var Item in Model.Items)
                                {
                                <tr>
                                    <td>
                                        <img src="@Item.ImageUrl" style="width:50px; height:50px"/>
                                        <div>@Item.ItemName</div>
                                    </td>
                                    <td>@Item.UnitPrice</td>
                                        <td>@Item.Quantity</td>
                                    <td>@Item.ItemTotal</td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
           <div class="col-sm-4">
               <div class="card">
                   <div class="card-header">
                       <h3>Cart Summary</h3>
                   </div>
                   <div class="card-body">
                       <table class="table table-bordered">
                           <tr>
                               <td>Total</td>
                               <td>@Model.Total</td>
                           </tr>
                           <tr>
                               <td>Tax</td>
                               <td>@Model.Tax</td>
                           </tr>
                           <tr>
                               <td>Grand Total</td>
                               <td>@Model.GrandTotal</td>
                           </tr>
                       </table>
                       @if(@CurrentUser == null)
                       {
                           <a asp-action="Login" asp-controller="Login" class="btn btn-success">Checkout</a>
                       }
                       else
                       {
                           <a asp-action="Checkout" asp-controller="Cart" class="btn btn-success">Checkout</a>
                       }
                   </div>
               </div>
           </div>
        </div>
    }
    else
    {
    <div>
        <h3>This Cart is Empty</h3>
    </div>
    }
</div>

