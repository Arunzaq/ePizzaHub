@using ePizza.UI.Models.ApiResponses

@model IEnumerable<ItemResponseModel>
@{
    ViewData["Title"] = "Home Page";
    Layout = "FullSizeLayout";
}

<div style="background-color: darkslategrey; color: white; padding: 60px 0;">
    <div class="container">
        <div class="row align-items-center">
            <!-- Left side: Text -->
            <div class="col-md-8">
                <h1 class="display-5 fw-bold">Welcome To Pizza Station</h1>
                <p class="lead mb-4">Delicious Pizza Delivered</p>
                <a href="#heading" class="btn btn-success btn-lg">ORDER ONLINE NOW</a>
            </div>

            <!-- Right side: Image -->
            <div class="col-md-4 text-center">
                <img src="~/images/pngwing.com.png" class="img-fluid" alt="Pizza Image" />
            </div>
        </div>
    </div>
</div>
<div class="container pt-3">
    <h1 class="mb-3">Pizza, Beverages</h1>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-sm-4 mb-3">
                <div class="card">
                    <img src="@item.ImageUrl" class="card-img-top" />
                    <div class="card-body">
                        <h5 class="class-title">
                            @item.Name
                            <span class="float-end">$@item.UnitPrice</span>
                        </h5>
                        <p class="card-text">@item.Description</p>
                    </div>
                    <div>
                        <span>Size : Regular</span>
                        <span class="float-end">
                            <a class="btn btn-primary">ADD TO CART</a>
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

